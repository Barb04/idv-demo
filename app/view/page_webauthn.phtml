<div id="form_container">
  <div class="page_title">Passwordless Registration</div>
  <div class="page_content">Register this device for passwordless sign-in using your fingerprint, face, or PIN.</div>

  <div class="onboarding-card text-center">
    <div id="webauthn-status">
      <button id="register-btn" class="btn" style="background-color:#E2231A; color:white;">Register This Device</button>
    </div>
  </div>
</div>
    
<script>
const options = <?php echo json_encode($_SESSION['SITE']['webauthn_options'] ?? []); ?>;
console.log('RAW OPTIONS FROM SERVER:', JSON.stringify(options, null, 2));

function base64UrlToBuffer(base64Url) {
  const padding = '='.repeat((4 - base64Url.length % 4) % 4);
  const base64 = (base64Url + padding).replace(/-/g, '+').replace(/_/g, '/');
  const raw = atob(base64);
  const buffer = new Uint8Array(raw.length);
  for (let i = 0; i < raw.length; i++) buffer[i] = raw.charCodeAt(i);
  return buffer.buffer;
}

function bufferToBase64Url(buffer) {
  if (!buffer) return null;
  const bytes = new Uint8Array(buffer);
  let str = '';
  for (const b of bytes) str += String.fromCharCode(b);
  return btoa(str).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}

function bufferToBase64(buffer) {
  if (!buffer) return null;
  const bytes = new Uint8Array(buffer);
  let str = '';
  for (const b of bytes) str += String.fromCharCode(b);
  return btoa(str);
}

document.getElementById('register-btn').addEventListener('click', async () => {
  const statusDiv = document.getElementById('webauthn-status');
  try {
    const pubKeyCredParams = (options.pubKeyCredParams && options.pubKeyCredParams.length)
      ? options.pubKeyCredParams.slice()
      : [{ type: 'public-key', alg: -7 }];
    if (!pubKeyCredParams.some(p => p.alg === -257)) {
      pubKeyCredParams.push({ type: 'public-key', alg: -257 });
    }

    const publicKey = {
      rp: options.rp,
      user: {
        id: base64UrlToBuffer(options.user.id),
        name: options.user.name,
        displayName: options.user.displayName
      },
      challenge: base64UrlToBuffer(options.challenge),
      pubKeyCredParams: pubKeyCredParams,
      timeout: options.timeout || 60000,
      attestation: options.attestation || 'none',
     authenticatorSelection: options.authenticatorSelection || { userVerification: 'preferred' },
      excludeCredentials: []
    };

    console.log('FINAL PUBLIC KEY OBJECT:', JSON.stringify(publicKey, (k, v) => v instanceof ArrayBuffer ? Array.from(new Uint8Array(v)) : v, 2));

    const credential = await navigator.credentials.create({ publicKey });
    const response = credential.response;

    let authDataStr = null;
    if (typeof response.getAuthenticatorData === 'function') {
      const data = response.getAuthenticatorData();
      if (data) authDataStr = bufferToBase64(data);
    }

    let pubKeyStr = null;
    if (typeof response.getPublicKey === 'function') {
      const key = response.getPublicKey();
      if (key) pubKeyStr = bufferToBase64(key);
    }

    let pubKeyAlgVal = null;
    if (typeof response.getPublicKeyAlgorithm === 'function') {
      pubKeyAlgVal = response.getPublicKeyAlgorithm();
    }

    let transportsArr = [];
    if (typeof response.getTransports === 'function') {
      transportsArr = response.getTransports() || [];
    }
    const result = {
      id: credential.id,
      rawId: bufferToBase64Url(credential.rawId),
      type: credential.type,
      authenticatorAttachment: credential.authenticatorAttachment || null,
      getClientExtensionResults: credential.getClientExtensionResults ? credential.getClientExtensionResults() : {},
      dns: window.location.hostname,   // or hardcode 'dev.idv-demo.local'
      response: {
        attestationObject: bufferToBase64Url(response.attestationObject),
        clientDataJSON: bufferToBase64Url(response.clientDataJSON),
        getAuthenticatorData: {},
        getPublicKey: {},
        getPublicKeyAlgorithm: {},
        getTransports: {}
      }
    };

    console.log('PAYLOAD BEING SENT:', JSON.stringify(result, null, 2));
    statusDiv.innerHTML = '<pre style="white-space: pre-wrap; word-break: break-all; text-align:left; font-size:11px;">' + JSON.stringify(result, null, 2) + '</pre><p>Verifying with server...</p>';

    const formBody = new URLSearchParams();
    formBody.append('do', 'webauthn_register');
    formBody.append('result', JSON.stringify(result));

    const resp = await fetch('<?php echo $_SESSION["SITE"]["site_url"]; ?>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: formBody
    });

    const text = await resp.text();
    statusDiv.innerHTML = '<pre style="white-space: pre-wrap; word-break: break-all; text-align:left;">' + text + '</pre>';

  } catch (err) {
    statusDiv.innerHTML = '<p style="color:#b00;">Error: ' + err.message + '</p>';
  }
});
</script>